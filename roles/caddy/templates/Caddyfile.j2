# Managed by Ansible — do not edit manually

{# Homer ping tiles HEAD each vhost cross-origin, so every proxied service must
   allow the dashboard's origin or the browser discards the response and the
   tile reads as down. HEAD with no custom headers is a simple request, so a
   response ACAO is enough — no preflight handling, and deliberately no
   Allow-Credentials.
   The > prefix defers the op until after the proxy has written its response
   headers, so it replaces an upstream ACAO instead of appending a second one:
   Actual and Pi-hole both send their own `*`, and a browser rejects any
   response carrying two different ACAO values. #}
{% set homer_origin = 'https://' ~ hostvars['homer'].caddy_proxy.hostname if 'homer' in groups['lxc_all'] else none %}
{% for host in groups['lxc_all'] | sort %}
{% if hostvars[host].caddy_proxy is defined %}
{% set proxy = hostvars[host].caddy_proxy %}
{{ proxy.hostname }} {
	tls internal
{% if homer_origin and host != 'homer' %}
	header >Access-Control-Allow-Origin "{{ homer_origin }}"
{% endif %}
{% if host == 'homer' %}
	{# python -m http.server sends only Last-Modified, so browsers apply
	   heuristic freshness and can serve a stale dashboard config for hours
	   after a deploy. The page is tiny; revalidate every load. #}
	@dashboard_config path /assets/config.yml
	header @dashboard_config Cache-Control "no-cache"
{% endif %}
{% if proxy.tls_insecure | default(false) %}
	reverse_proxy {{ proxy.scheme }}://{{ hostvars[host].ansible_host }}:{{ proxy.port }} {
		transport http {
			tls_insecure_skip_verify
		}
	}
{% else %}
	reverse_proxy {{ proxy.scheme }}://{{ hostvars[host].ansible_host }}:{{ proxy.port }} {
		header_up Host {host}
	}
{% endif %}
}

{% endif %}
{% endfor %}
